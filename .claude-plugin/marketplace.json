{
  "name": "yogi-skills",
  "owner": {
    "name": "Yogiraj Aradhye"
  },
  "metadata": {
    "description": "A working collection of Claude Code skills, split into suites so each repo enables only what it needs.",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "kb-wiki",
      "source": "./",
      "displayName": "Knowledge base (LLM wiki)",
      "description": "The LLM-wiki pattern as three skills: query the wiki before working, ingest sources and lint it after, and a compatibility alias.",
      "version": "1.0.0",
      "author": {
        "name": "Yogiraj Aradhye"
      },
      "homepage": "https://github.com/YogirajA/Claude-Skills",
      "repository": "https://github.com/YogirajA/Claude-Skills",
      "license": "MIT",
      "category": "workflow",
      "keywords": [
        "knowledge-base",
        "wiki",
        "documentation",
        "context"
      ],
      "skills": [
        "./read-wiki",
        "./wiki",
        "./write-wiki"
      ]
    },
    {
      "name": "repo-onboarding",
      "source": "./",
      "displayName": "Repo onboarding and harness setup",
      "description": "Onboard Claude onto a repository so it holds durable, verified context: recon, mutual interrogation, an executed feedback loop, a capped CLAUDE.md, a project wiki, and an interview-gated .claude/ harness.",
      "version": "1.0.0",
      "author": {
        "name": "Yogiraj Aradhye"
      },
      "homepage": "https://github.com/YogirajA/Claude-Skills",
