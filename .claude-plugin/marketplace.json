      "license": "MIT",
      "category": "workflow",
      "keywords": [
        "onboarding",
        "claude-md",
        "hooks",
        "settings",
        "harness"
      ],
      "skills": [
        "./onboard-light",
        "./onboard-repo",
        "./primitive-classifier",
        "./setup-matt-pocock-skills"
      ]
    },
    {
      "name": "harness-audit",
      "source": "./",
      "displayName": "Harness measurement and hygiene",
      "description": "Measure the harness instead of trusting it: audit context consumption, garbage-collect the config, test whether skills and rules are actually obeyed, design agent loops that cannot run away, and search before writing a new skill. Adapted from affaan-m/ECC.",
      "version": "1.0.0",
      "author": {
        "name": "Yogiraj Aradhye"
      },
      "homepage": "https://github.com/YogirajA/Claude-Skills",
