        "./context-budget",
        "./gateguard",
        "./loop-design-check",
        "./skill-comply",
        "./skill-scout"
      ]
    },
    {
      "name": "token-economy",
      "source": "./",
      "displayName": "Token economy (caveman)",
      "description": "Cut output tokens without losing technical substance: terse response modes, a compressor for stored context, and compressed subagent presets. Adapted from JuliusBrussee/caveman.",
      "version": "1.0.0",
      "author": {
        "name": "Yogiraj Aradhye"
      },
      "homepage": "https://github.com/YogirajA/Claude-Skills",
